# Copy this file to .env and fill in your own values:  cp .env.example .env

# ── Groq ──────────────────────────────────────────────────────────────────────
# Get free keys from: https://console.groq.com/keys
# Key 1 (required) → detect agent + tiebreaker agent
GROQ_API_KEY=
# Key 2 (optional) → critique agent (skeptic). Falls back to GROQ_API_KEY.
GROQ_API_KEY_2=
# Key 3 (optional) → verify agent (defender). Falls back to GROQ_API_KEY.
# Separate keys give each agent its own per-minute token budget.
GROQ_API_KEY_3=

# ── Langfuse (optional) ───────────────────────────────────────────────────────
# If not set, prompts are read from local .txt files and tracing is disabled.
# Get keys from: https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
