# Copy this file to .env and fill in your own values:  cp .env.example .env

# ── Groq (required) ───────────────────────────────────────────────────────────
# Get a free key from: https://console.groq.com/keys
GROQ_API_KEY=

# ── Langfuse (optional) ───────────────────────────────────────────────────────
# If not set, prompts are read from local .txt files and tracing is disabled.
# Get keys from: https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
